 <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي برميل النانو - Nano Barrel Challenge</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #f0f4f8;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            color: #2d3436;
        }

        #game-container {
            background: white;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 90%;
            max-width: 400px;
            text-align: center;
        }

        .stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            font-weight: bold;
        }

        #timer { color: #d63031; }
        #level-text { color: #0984e3; }

        /* تصميم البرميل */
        #barrel-outer {
            width: 120px;
            height: 180px;
            border: 5px solid #2d3436;
            margin: 20px auto;
            border-radius: 10px 10px 40px 40px;
            position: relative;
            background: #dfe6e9;
            overflow: hidden;
        }

        #water {
            width: 100%;
            height: 0%;
            background: linear-gradient(to top, #0984e3, #74b9ff);
            position: absolute;
            bottom: 0;
            transition: height 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        #question-box {
            min-height: 100px;
            margin-bottom: 20px;
        }

        input[type="number"] {
            width: 80%;
            padding: 12px;
            border: 2px solid #dfe6e9;
            border-radius: 10px;
            font-size: 18px;
            margin-bottom: 15px;
            outline: none;
            text-align: center;
        }

        button {
            background-color: #00b894;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
            transition: transform 0.2s;
            width: 80%;
        }

        button:active { transform: scale(0.95); }

        .hidden { display: none; }
        
        #message { margin-top: 15px; font-weight: bold; min-height: 24px; }
    </style>
</head>
<body>

<div id="game-container">
    <div class="stats">
        <div id="level-text">المستوى: 1/5</div>
        <div id="timer">الوقت: 90</div>
    </div>

    <div id="barrel-outer">
        <div id="water"></div>
    </div>

    <div id="game-play">
        <div id="question-box">
            <p id="question-text">تحميل السؤال...</p>
        </div>
        <input type="number" id="answer-input" placeholder="اكتب الإجابة هنا">
        <button onclick="checkAnswer()">تحقق من الإجابة</button>
        <div id="message"></div>
    </div>

    <div id="result-screen" class="hidden">
        <h2>🎉 مبروك!</h2>
        <p id="final-score"></p>
        <button onclick="location.reload()">إعادة المحاولة</button>
    </div>
</div>

<script>
    const questions = [
        { q: "إذا كان طول خلية بكتيرية 2 ميكرومتر (μm)، فكم يبلغ طولها بوحدة النانومتر (nm)؟", a: 2000 },
        { q: "غشاء حيوي سمكه 0.05 مليمتر (mm). كم يبلغ سمكه بوحدة النانومتر (nm)؟", a: 50000 },
        { q: "جسيم نانوي قطره 1 × 10⁻⁷ متر (m). حول هذا القطر إلى وحدة النانومتر (nm)؟", a: 100 },
        { q: "إذا كان قطر الـ DNA هو 2.5 نانومتر، كم جزيئاً نحتاج لنشكل خيطاً بطول 1 ميكرومتر؟", a: 400 },
        { q: "مكعب طول ضلعه 1 ميكرومتر، تم تقسيمه لمكعبات طول ضلعها 1 نانومتر. كم عدد المكعبات الناتجة؟", a: 1000000000 }
    ];

    let currentLevel = 0;
    let timeLeft = 90;
    let timer;

    function startGame() {
        showQuestion();
        timer = setInterval(updateTimer, 1000);
    }

    function showQuestion() {
        if (currentLevel < questions.length) {
            document.getElementById('question-text').innerText = questions[currentLevel].q;
            document.getElementById('level-text').innerText = `المستوى: ${currentLevel + 1}/5`;
            document.getElementById('answer-input').value = '';
            document.getElementById('message').innerText = '';
        } else {
            endGame(true);
        }
    }

    function checkAnswer() {
        const userAnswer = document.getElementById('answer-input').value;
        const correctAnswer = questions[currentLevel].a;

        if (parseInt(userAnswer) === correctAnswer) {
            currentLevel++;
            updateWater();
            document.getElementById('message').style.color = "#00b894";
            document.getElementById('message').innerText = "إجابة صحيحة! استمر..";
            setTimeout(showQuestion, 1000);
        } else {
            document.getElementById('message').style.color = "#d63031";
            document.getElementById('message').innerText = "إجابة خاطئة، حاول مرة أخرى";
        }
    }

    function updateWater() {
        const percentage = (currentLevel / questions.length) * 100;
        document.getElementById('water').style.height = percentage + '%';
    }

    function updateTimer() {
        timeLeft--;
        document.getElementById('timer').innerText = `الوقت: ${timeLeft}`;
        if (timeLeft <= 0) {
            endGame(false);
        }
    }

    function endGame(win) {
        clearInterval(timer);
        document.getElementById('game-play').classList.add('hidden');
        document.getElementById('result-screen').classList.remove('hidden');
        if (win) {
            document.getElementById('final-score').innerText = `لقد ملأت البرميل بنجاح في ${90 - timeLeft} ثانية!`;
        } else {
            document.getElementById('final-score').innerText = "انتهى الوقت! حاول أن تكون أسرع في المرة القادمة.";
        }
    }

    window.onload = startGame;
</script>

</body>
</html>
